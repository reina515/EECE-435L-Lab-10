pipeline {
    agent any
    environment {
        VIRTUAL_ENV = 'venv'
        PYTHON = 'C:\\Users\\ASUS\\AppData\\Local\\Programs\\Python\\Python310\\python.exe'
        DEPLOY_DIR = 'C:\\jenkins_deploy'
    }
    stages {
        stage('Setup') {
            steps {
                script {
                    if (!fileExists("${env.VIRTUAL_ENV}")) {
                        bat '"%PYTHON%" -m venv %VIRTUAL_ENV%'
                    }
                    bat 'call %VIRTUAL_ENV%\\Scripts\\activate.bat && pip install -r requirements.txt'
                }
            }
        }
        stage('Lint') {
            steps {
                script {
                    bat 'call %VIRTUAL_ENV%\\Scripts\\activate.bat && flake8 app.py deploy.py'
                }
            }
        }
        stage('Test') {
            steps {
                script {
                    bat 'call %VIRTUAL_ENV%\\Scripts\\activate.bat && python -m pytest'
                }
            }
        }
        stage('Coverage') {
            steps {
                script {
                    bat 'call %VIRTUAL_ENV%\\Scripts\\activate.bat && coverage run --source=app -m pytest && coverage report -m && coverage html'
                }
            }
        }
        stage('Security Scan') {
            steps {
                script {
                    bat 'call %VIRTUAL_ENV%\\Scripts\\activate.bat && bandit app.py deploy.py && bandit app.py deploy.py -f txt -o bandit_report.txt'
                }
            }
        }
        stage('Deploy') {
            steps {
                script {
                    echo "Deploying application..."
                    bat 'call %VIRTUAL_ENV%\\Scripts\\activate.bat && python deploy.py'
                }
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'htmlcov/**, bandit_report.txt', allowEmptyArchive: true
            cleanWs()
        }
    }
}
